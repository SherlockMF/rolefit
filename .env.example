# LLM 配置（勿在代码中硬编码模型，由此处配置）
# mock：无 API Key 时使用内置示例（本地开发）
# openai / compatible：OpenAI 或兼容端点
LLM_PROVIDER=mock

# 开发页脚展示（可选，与 LLM_* 保持一致）
NEXT_PUBLIC_LLM_PROVIDER=mock
NEXT_PUBLIC_LLM_MODEL=mock

# 智谱 GLM-5.1（推荐，OpenAI 兼容）：
# LLM_PROVIDER=compatible
# LLM_API_KEY=你的智谱开放平台 API Key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.1
#
# 其他 OpenAI 兼容服务（DeepSeek 等）：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id

# 未来 Supabase（MVP 未使用）
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
